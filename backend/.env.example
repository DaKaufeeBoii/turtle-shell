# StandupSloth Configuration
PORT=3456

# Local Gemma 2 9B (via Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b

# MongoDB Atlas (Optional - uses local JSON history if empty)
# Free M0 cluster connection string:
MONGODB_URI=
MONGODB_DB_NAME=standup_sloth

# Sentry Agent Tracing (Optional - traces run in log mode if empty)
# Sentry DSN:
SENTRY_DSN=
